# Copier en .env sur le VPS avant déploiement
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi-en-production
JWT_SECRET=generez-une-chaine-aleatoire-longue

# Stirling-PDF (/pdf) : protégé par le login admin Souba (cookie JWT + Traefik ForwardAuth).
# SECURITY_ENABLELOGIN reste false — le login Stirling sous /pdf casse les assets (./assets → 404).
